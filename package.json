{
  "name": "automacao",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:login": "cypress run --spec cypress/e2e/login.cy.js",
    "cy:run:login:chrome": "cypress run --browser chrome --headed --spec cypress/e2e/login.cy.js",
    "cy:run:responsive:mobile": "cypress run --spec cypress/e2e/login.responsive.mobile.cy.js",
    "cy:run:a11y": "cypress run --spec cypress/e2e/login.accessibility.cy.js",
    "cy:run:security": "cypress run --spec cypress/e2e/login.security.cy.js",
    "cy:run:performance": "cypress run --spec cypress/e2e/login.performance.cy.js",
    "test": "cypress run"
  },
